diff --git a/src/scss/blocks/_project-info-krygina.scss b/src/scss/blocks/_project-info-krygina.scss
new file mode 100644
index 0000000..e8dbc4d
--- /dev/null
+++ b/src/scss/blocks/_project-info-krygina.scss
@@ -0,0 +1,407 @@
+$krygina-red: #db001c;
+$krygina-red-deep: #b00e17;
+$krygina-lavender: #f1eff5;
+
+.project-info-krygina {
+  overflow-x: hidden;
+
+  // ===== Шапка кейса (заголовок / теги / задача-решение) =====
+  // Паттерн 1-в-1 повторяет остальные кейсы проекта (см. _projectinfo.scss)
+  &__container {
+    margin: 60px 0 30px 0;
+    display: flex;
+    justify-content: space-between;
+  }
+
+  &__title {
+    font-family: "Cakra", sans-serif;
+    font-size: 26px;
+    font-weight: 500;
+  }
+
+  &__tags {
+    font-family: "Intel-light", sans-serif;
+    font-style: italic;
+    font-size: 18px;
+  }
+
+  &__block {
+    max-width: 463px;
+  }
+
+  &__objectives {
+    max-width: 400px;
+    font-family: "Intel-light", sans-serif;
+    font-size: 18px;
+    padding-right: 8px;
+  }
+
+  &__solution {
+    margin-top: 10px;
+  }
+
+  &__task-title,
+  &__solution-title {
+    position: relative;
+    display: inline-block;
+
+    &::before {
+      content: "";
+      position: absolute;
+      left: 0;
+      right: 0;
+      bottom: -2px;
+      height: 40%;
+      background: rgba(0, 0, 0, 0.1);
+      z-index: 1;
+    }
+  }
+
+  // ===== Hero: KRYGINA / ALLURE BB CREAM =====
+  &__hero {
+    display: flex;
+    align-items: center;
+    min-height: 460px;
+    margin-bottom: 60px;
+  }
+
+  &__hero-content {
+    flex: 0 0 42%;
+    max-width: 420px;
+    padding-right: 30px;
+  }
+
+  &__hero-logo {
+    font-family: "Gilroy-Bold", sans-serif;
+    font-weight: bold;
+    font-size: 88px;
+    line-height: 0.92;
+    letter-spacing: -1px;
+    color: $krygina-red;
+  }
+
+  &__hero-subtitle {
+    font-family: "Gilroy-Bold", sans-serif;
+    font-weight: bold;
+    font-size: 26px;
+    letter-spacing: 1px;
+    color: $krygina-red;
+    margin-top: 10px;
+  }
+
+  &__hero-text {
+    font-family: "Intel-light", sans-serif;
+    font-size: 17px;
+    line-height: 1.5;
+    color: #1a1a1a;
+    margin-top: 20px;
+    max-width: 340px;
+  }
+
+  &__hero-image {
+    flex: 1;
+    height: 460px;
+    width: 100%;
+    object-fit: cover;
+  }
+
+  // ===== Сплит: видео/фото 50 на 50, встык =====
+  &__split {
+    display: flex;
+    gap: 0;
+    margin-bottom: 60px;
+  }
+
+  &__split-item {
+    flex: 1 1 50%;
+    height: 620px;
+    overflow: hidden;
+
+    img,
+    .video-player {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    &--red {
+      background-color: $krygina-red-deep;
+    }
+  }
+
+  // ===== Оттенки 01 / 02 / 03 =====
+  &__shades {
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    gap: 20px;
+    margin-bottom: 60px;
+  }
+
+  &__shade-image {
+    width: 100%;
+    aspect-ratio: 1 / 1;
+    object-fit: cover;
+    margin-bottom: 20px;
+  }
+
+  &__shade-name {
+    font-family: "Gilroy-Bold", sans-serif;
+    font-weight: bold;
+    font-size: 20px;
+    letter-spacing: 0.5px;
+    color: $krygina-red;
+  }
+
+  &__shade-description {
+    font-family: "AvantGardeGothicC", sans-serif;
+    font-size: 16px;
+    color: $krygina-red;
+    opacity: 0.85;
+    margin-top: 6px;
+  }
+
+  // ===== Красная секция с сеткой SMM-карточек (full-bleed) =====
+  &__gallery {
+    background-color: $krygina-red-deep;
+    width: 100vw;
+    margin-left: calc(50% - 50vw);
+    margin-right: calc(50% - 50vw);
+    padding: 60px 0;
+    margin-bottom: 60px;
+  }
+
+  &__gallery-grid {
+    max-width: 1080px;
+    margin: 0 auto;
+    padding: 0 20px;
+    display: grid;
+    grid-template-columns: repeat(5, 1fr);
+    gap: 20px;
+  }
+
+  &__gallery-image {
+    width: 100%;
+    aspect-ratio: 3 / 3.5;
+    object-fit: cover;
+  }
+
+  // ===== До / после (одна фотография + подписи) =====
+  &__before-after {
+    position: relative;
+    margin-bottom: 60px;
+  }
+
+  &__before-after-image {
+    display: block;
+    width: 100%;
+    aspect-ratio: 2 / 1;
+    object-fit: cover;
+  }
+
+  &__before-after-badge {
+    position: absolute;
+    bottom: 32px;
+    background-color: $krygina-red;
+    color: #ffffff;
+    font-family: "Gilroy-Bold", sans-serif;
+    font-weight: bold;
+    font-size: 18px;
+    letter-spacing: 1px;
+    padding: 10px 28px;
+
+    &--before {
+      left: 32px;
+    }
+
+    &--after {
+      right: 32px;
+    }
+  }
+
+  // ===== Упаковка =====
+  &__packaging {
+    display: flex;
+    gap: 24px;
+    margin-bottom: 60px;
+  }
+
+  &__packaging-image {
+    flex: 1 1 50%;
+    width: 100%;
+    height: 620px;
+    object-fit: cover;
+  }
+
+  // ===== Финальный логотип (full-bleed) =====
+  &__outro {
+    background-color: $krygina-lavender;
+    width: 100vw;
+    margin-left: calc(50% - 50vw);
+    margin-right: calc(50% - 50vw);
+    padding: 140px 0;
+    text-align: center;
+  }
+
+  &__outro-logo {
+    font-family: "Gilroy-Bold", sans-serif;
+    font-weight: bold;
+    font-size: 84px;
+    letter-spacing: -1px;
+    color: $krygina-red;
+  }
+}
+
+// ===================== Адаптив =====================
+@media (max-width: 1024px) {
+  .project-info-krygina {
+    &__container {
+      flex-direction: column;
+      gap: 30px;
+      margin: 30px 0 20px 0;
+    }
+
+    &__title {
+      font-size: 22px;
+      text-align: center;
+    }
+
+    &__tags {
+      font-size: 16px;
+      text-align: center;
+    }
+
+    &__block,
+    &__objectives {
+      max-width: 100%;
+    }
+
+    &__hero {
+      flex-direction: column;
+      align-items: stretch;
+      min-height: auto;
+      gap: 24px;
+    }
+
+    &__hero-content {
+      flex: none;
+      max-width: 100%;
+      padding-right: 0;
+      text-align: center;
+    }
+
+    &__hero-logo {
+      font-size: 64px;
+    }
+
+    &__hero-text {
+      max-width: 100%;
+      margin-left: auto;
+      margin-right: auto;
+    }
+
+    &__hero-image {
+      height: 320px;
+    }
+
+    &__split {
+      flex-direction: column;
+    }
+
+    &__split-item {
+      height: 420px;
+    }
+
+    &__gallery-grid {
+      grid-template-columns: repeat(3, 1fr);
+    }
+
+    &__packaging {
+      flex-direction: column;
+    }
+
+    &__packaging-image {
+      height: 420px;
+    }
+
+    &__outro {
+      padding: 90px 0;
+    }
+
+    &__outro-logo {
+      font-size: 56px;
+    }
+  }
+}
+
+@media (max-width: 767px) {
+  .project-info-krygina {
+    &__hero-logo {
+      font-size: 44px;
+    }
+
+    &__hero-subtitle {
+      font-size: 20px;
+    }
+
+    &__hero-text {
+      font-size: 15px;
+    }
+
+    &__hero-image {
+      height: 240px;
+    }
+
+    &__split-item {
+      height: 280px;
+    }
+
+    &__shades {
+      grid-template-columns: 1fr;
+      gap: 30px;
+    }
+
+    &__shade-image {
+      aspect-ratio: 4 / 3;
+    }
+
+    &__gallery {
+      padding: 40px 0;
+    }
+
+    &__gallery-grid {
+      grid-template-columns: repeat(2, 1fr);
+      gap: 14px;
+      padding: 0 20px;
+    }
+
+    &__before-after-image {
+      aspect-ratio: 1 / 1;
+    }
+
+    &__before-after-badge {
+      font-size: 13px;
+      padding: 7px 16px;
+      bottom: 16px;
+
+      &--before {
+        left: 16px;
+      }
+
+      &--after {
+        right: 16px;
+      }
+    }
+
+    &__packaging-image {
+      height: 280px;
+    }
+
+    &__outro {
+      padding: 60px 0;
+    }
+
+    &__outro-logo {
+      font-size: 40px;
+    }
+  }
+}
diff --git a/src/scss/blocks/_videoplayer.scss b/src/scss/blocks/_videoplayer.scss
new file mode 100644
index 0000000..82168fd
--- /dev/null
+++ b/src/scss/blocks/_videoplayer.scss
@@ -0,0 +1,76 @@
+.video-player {
+  display: block;
+  width: 100%;
+  height: 100%;
+  border: none;
+  padding: 0;
+  margin: 0;
+  background: none;
+  cursor: pointer;
+  position: relative;
+
+  &--poster {
+    position: relative;
+
+    &:hover .video-player__play,
+    &:focus-visible .video-player__play {
+      transform: scale(1.06);
+      background: #ffffff;
+    }
+
+    &:focus-visible {
+      outline: 2px solid #1a1a1a;
+      outline-offset: 4px;
+    }
+  }
+
+  &__poster-image {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+
+  &__play {
+    position: absolute;
+    top: 32px;
+    left: 32px;
+    width: 64px;
+    height: 64px;
+    border-radius: 50%;
+    background: rgba(255, 255, 255, 0.92);
+    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    color: #1a1a1a;
+    transition: transform 0.2s ease, background 0.2s ease;
+  }
+}
+
+video.video-player {
+  cursor: default;
+}
+
+@media (max-width: 767px) {
+  .video-player {
+    &__play {
+      top: 20px;
+      left: 20px;
+      width: 48px;
+      height: 48px;
+    }
+
+    &__play svg {
+      width: 20px;
+      height: 20px;
+    }
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .video-player--poster:hover .video-player__play,
+  .video-player--poster:focus-visible .video-player__play {
+    transform: none;
+  }
+}
