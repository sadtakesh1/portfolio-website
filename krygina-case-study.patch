diff --git a/src/components/VideoPlayer.jsx b/src/components/VideoPlayer.jsx
new file mode 100644
index 0000000..2d9b99c
--- /dev/null
+++ b/src/components/VideoPlayer.jsx
@@ -0,0 +1,56 @@
+import { useState } from "react";
+
+/**
+ * Лёгкий видео-плеер с превью-картинкой вместо тяжёлого автозапуска.
+ *
+ * Пока пользователь не нажал play, в DOM нет тега <video> вообще —
+ * грузится только превью-изображение (как обычная lazy-картинка).
+ * Само видео запрашивается из сети только по клику, поэтому блок
+ * ничего не весит, пока его не запустили.
+ *
+ * Проп poster принимает обычную фотографию (не обязательно кадр
+ * из видео) — так превью можно подобрать вручную, как на макете.
+ */
+function VideoPlayer({ src, poster, alt = "", className = "" }) {
+  const [isPlaying, setIsPlaying] = useState(false);
+
+  if (isPlaying) {
+    return (
+      <video
+        className={`video-player ${className}`}
+        src={src}
+        poster={poster}
+        controls
+        autoPlay
+        playsInline
+        preload="metadata"
+      >
+        Ваш браузер не поддерживает воспроизведение видео.
+      </video>
+    );
+  }
+
+  return (
+    <button
+      type="button"
+      className={`video-player video-player--poster ${className}`}
+      onClick={() => setIsPlaying(true)}
+      aria-label="Воспроизвести видео"
+    >
+      <img
+        className="video-player__poster-image"
+        src={poster}
+        alt={alt}
+        loading="lazy"
+        decoding="async"
+      />
+      <span className="video-player__play" aria-hidden="true">
+        <svg viewBox="0 0 24 24" width="28" height="28">
+          <path d="M8 5v14l11-7z" fill="currentColor" />
+        </svg>
+      </span>
+    </button>
+  );
+}
+
+export default VideoPlayer;
