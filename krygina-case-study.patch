+}
+
+.video-player {
+  display: block;
+  width: 100%;
+  height: 100%;
+  border: none;
+  padding: 0;
+  margin: 0;
+  background: none;
+  cursor: pointer;
+  position: relative;
+}
+.video-player--poster {
+  position: relative;
+}
+.video-player--poster:hover .video-player__play, .video-player--poster:focus-visible .video-player__play {
+  transform: scale(1.06);
+  background: #ffffff;
+}
+.video-player--poster:focus-visible {
+  outline: 2px solid #1a1a1a;
+  outline-offset: 4px;
+}
+.video-player__poster-image {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+.video-player__play {
+  position: absolute;
+  top: 32px;
+  left: 32px;
+  width: 64px;
+  height: 64px;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.92);
+  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #1a1a1a;
+  transition: transform 0.2s ease, background 0.2s ease;
+}
+
+video.video-player {
+  cursor: default;
+}
+
+@media (max-width: 767px) {
+  .video-player__play {
+    top: 20px;
+    left: 20px;
+    width: 48px;
+    height: 48px;
+  }
+  .video-player__play svg {
+    width: 20px;
+    height: 20px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .video-player--poster:hover .video-player__play,
+  .video-player--poster:focus-visible .video-player__play {
+    transform: none;
+  }
+}
+.project-info-krygina {
+  overflow-x: hidden;
+}
+.project-info-krygina__container {
+  margin: 60px 0 30px 0;
+  display: flex;
+  justify-content: space-between;
+}
+.project-info-krygina__title {
+  font-family: "Cakra", sans-serif;
+  font-size: 26px;
+  font-weight: 500;
+}
+.project-info-krygina__tags {
+  font-family: "Intel-light", sans-serif;
+  font-style: italic;
+  font-size: 18px;
+}
+.project-info-krygina__block {
+  max-width: 463px;
+}
+.project-info-krygina__objectives {
+  max-width: 400px;
+  font-family: "Intel-light", sans-serif;
+  font-size: 18px;
+  padding-right: 8px;
+}
+.project-info-krygina__solution {
+  margin-top: 10px;
+}
+.project-info-krygina__task-title, .project-info-krygina__solution-title {
+  position: relative;
+  display: inline-block;
+}
+.project-info-krygina__task-title::before, .project-info-krygina__solution-title::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: -2px;
+  height: 40%;
+  background: rgba(0, 0, 0, 0.1);
+  z-index: 1;
+}
+.project-info-krygina__hero {
+  display: flex;
+  align-items: center;
+  min-height: 460px;
+  margin-bottom: 60px;
+}
+.project-info-krygina__hero-content {
+  flex: 0 0 42%;
+  max-width: 420px;
+  padding-right: 30px;
+}
+.project-info-krygina__hero-logo {
+  font-family: "Gilroy-Bold", sans-serif;
+  font-weight: bold;
+  font-size: 88px;
+  line-height: 0.92;
+  letter-spacing: -1px;
+  color: #db001c;
+}
+.project-info-krygina__hero-subtitle {
+  font-family: "Gilroy-Bold", sans-serif;
+  font-weight: bold;
+  font-size: 26px;
+  letter-spacing: 1px;
+  color: #db001c;
+  margin-top: 10px;
+}
+.project-info-krygina__hero-text {
+  font-family: "Intel-light", sans-serif;
+  font-size: 17px;
+  line-height: 1.5;
+  color: #1a1a1a;
+  margin-top: 20px;
+  max-width: 340px;
+}
+.project-info-krygina__hero-image {
+  flex: 1;
+  height: 460px;
+  width: 100%;
+  object-fit: cover;
+}
+.project-info-krygina__split {
+  display: flex;
+  gap: 0;
+  margin-bottom: 60px;
+}
+.project-info-krygina__split-item {
+  flex: 1 1 50%;
+  height: 620px;
+  overflow: hidden;
+}
+.project-info-krygina__split-item img,
+.project-info-krygina__split-item .video-player {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+.project-info-krygina__split-item--red {
+  background-color: #b00e17;
+}
+.project-info-krygina__shades {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 20px;
+  margin-bottom: 60px;
+}
+.project-info-krygina__shade-image {
+  width: 100%;
+  aspect-ratio: 1/1;
+  object-fit: cover;
+  margin-bottom: 20px;
+}
+.project-info-krygina__shade-name {
+  font-family: "Gilroy-Bold", sans-serif;
+  font-weight: bold;
+  font-size: 20px;
+  letter-spacing: 0.5px;
+  color: #db001c;
+}
+.project-info-krygina__shade-description {
+  font-family: "AvantGardeGothicC", sans-serif;
+  font-size: 16px;
+  color: #db001c;
+  opacity: 0.85;
+  margin-top: 6px;
+}
+.project-info-krygina__gallery {
+  background-color: #b00e17;
+  width: 100vw;
+  margin-left: calc(50% - 50vw);
+  margin-right: calc(50% - 50vw);
+  padding: 60px 0;
+  margin-bottom: 60px;
+}
+.project-info-krygina__gallery-grid {
+  max-width: 1080px;
+  margin: 0 auto;
+  padding: 0 20px;
+  display: grid;
+  grid-template-columns: repeat(5, 1fr);
+  gap: 20px;
+}
+.project-info-krygina__gallery-image {
+  width: 100%;
+  aspect-ratio: 3/3.5;
+  object-fit: cover;
+}
+.project-info-krygina__before-after {
+  position: relative;
+  margin-bottom: 60px;
+}
+.project-info-krygina__before-after-image {
+  display: block;
+  width: 100%;
+  aspect-ratio: 2/1;
+  object-fit: cover;
+}
+.project-info-krygina__before-after-badge {
+  position: absolute;
+  bottom: 32px;
+  background-color: #db001c;
+  color: #ffffff;
+  font-family: "Gilroy-Bold", sans-serif;
+  font-weight: bold;
+  font-size: 18px;
+  letter-spacing: 1px;
+  padding: 10px 28px;
+}
+.project-info-krygina__before-after-badge--before {
+  left: 32px;
+}
+.project-info-krygina__before-after-badge--after {
+  right: 32px;
+}
+.project-info-krygina__packaging {
+  display: flex;
+  gap: 24px;
+  margin-bottom: 60px;
+}
+.project-info-krygina__packaging-image {
+  flex: 1 1 50%;
+  width: 100%;
+  height: 620px;
+  object-fit: cover;
+}
+.project-info-krygina__outro {
+  background-color: #f1eff5;
+  width: 100vw;
+  margin-left: calc(50% - 50vw);
+  margin-right: calc(50% - 50vw);
+  padding: 140px 0;
+  text-align: center;
+}
+.project-info-krygina__outro-logo {
+  font-family: "Gilroy-Bold", sans-serif;
+  font-weight: bold;
+  font-size: 84px;
+  letter-spacing: -1px;
+  color: #db001c;
+}
+
+@media (max-width: 1024px) {
+  .project-info-krygina__container {
+    flex-direction: column;
+    gap: 30px;
+    margin: 30px 0 20px 0;
+  }
+  .project-info-krygina__title {
+    font-size: 22px;
+    text-align: center;
+  }
+  .project-info-krygina__tags {
+    font-size: 16px;
+    text-align: center;
+  }
+  .project-info-krygina__block, .project-info-krygina__objectives {
+    max-width: 100%;
+  }
+  .project-info-krygina__hero {
+    flex-direction: column;
+    align-items: stretch;
+    min-height: auto;
+    gap: 24px;
+  }
+  .project-info-krygina__hero-content {
+    flex: none;
+    max-width: 100%;
+    padding-right: 0;
+    text-align: center;
+  }
+  .project-info-krygina__hero-logo {
+    font-size: 64px;
+  }
+  .project-info-krygina__hero-text {
+    max-width: 100%;
+    margin-left: auto;
+    margin-right: auto;
+  }
+  .project-info-krygina__hero-image {
+    height: 320px;
+  }
+  .project-info-krygina__split {
+    flex-direction: column;
+  }
+  .project-info-krygina__split-item {
+    height: 420px;
+  }
+  .project-info-krygina__gallery-grid {
+    grid-template-columns: repeat(3, 1fr);
+  }
+  .project-info-krygina__packaging {
+    flex-direction: column;
+  }
+  .project-info-krygina__packaging-image {
+    height: 420px;
+  }
+  .project-info-krygina__outro {
+    padding: 90px 0;
+  }
+  .project-info-krygina__outro-logo {
+    font-size: 56px;
+  }
+}
+@media (max-width: 767px) {
+  .project-info-krygina__hero-logo {
+    font-size: 44px;
+  }
+  .project-info-krygina__hero-subtitle {
+    font-size: 20px;
+  }
+  .project-info-krygina__hero-text {
+    font-size: 15px;
+  }
+  .project-info-krygina__hero-image {
+    height: 240px;
+  }
+  .project-info-krygina__split-item {
+    height: 280px;
+  }
+  .project-info-krygina__shades {
+    grid-template-columns: 1fr;
+    gap: 30px;
+  }
+  .project-info-krygina__shade-image {
+    aspect-ratio: 4/3;
+  }
+  .project-info-krygina__gallery {
+    padding: 40px 0;
+  }
+  .project-info-krygina__gallery-grid {
+    grid-template-columns: repeat(2, 1fr);
+    gap: 14px;
+    padding: 0 20px;
+  }
+  .project-info-krygina__before-after-image {
+    aspect-ratio: 1/1;
+  }
+  .project-info-krygina__before-after-badge {
+    font-size: 13px;
+    padding: 7px 16px;
+    bottom: 16px;
+  }
+  .project-info-krygina__before-after-badge--before {
+    left: 16px;
+  }
+  .project-info-krygina__before-after-badge--after {
+    right: 16px;
+  }
+  .project-info-krygina__packaging-image {
+    height: 280px;
+  }
+  .project-info-krygina__outro {
+    padding: 60px 0;
+  }
+  .project-info-krygina__outro-logo {
+    font-size: 40px;
+  }
+}
